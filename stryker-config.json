{
  "stryker-config": {
    "solution": "DotnetRaft.sln",
    "project": "DotnetRaft.csproj",
    "test-projects": [
      "tests/DotnetRaft.Tests/DotnetRaft.Tests.csproj"
    ],
    "configuration": "Release",
    "mutate": [
      "**/Core/RaftCore.cs",
      "**/Core/RaftClock.cs",
      "**/Core/RaftLog.cs",
      "**/Core/RaftOutput.cs",
      "**/Core/RaftRoleState.cs",
      "**/Core/UnstableLog.cs",
      "**/Tracker/ProgressTracker.cs"
    ],
    "reporters": [
      "cleartext",
      "json"
    ],
    "coverage-analysis": "perTest",
    "concurrency": 4,
    "thresholds": {
      "high": 85,
      "low": 75,
      "break": 0
    }
  }
}
