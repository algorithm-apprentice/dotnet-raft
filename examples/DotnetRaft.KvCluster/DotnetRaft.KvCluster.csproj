<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotnetRaft\DotnetRaft.csproj" />
    <ProjectReference Include="..\..\src\DotnetRaft.Sqlite\DotnetRaft.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.84.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos/transport.proto" GrpcServices="Both" />
    <!-- Reuse the wire classification without widening the package API. -->
    <Compile Include="..\..\src\DotnetRaft\Core\MessageClassifier.cs" Link="MessageClassifier.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotnetRaft.Tests" />
    <InternalsVisibleTo Include="DotnetRaft.RefactorBenchmarks" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Keep the linked source's internal type distinct from the core copy. -->
    <DefineConstants>$(DefineConstants);DOTNET_RAFT_KV_TRANSPORT</DefineConstants>
  </PropertyGroup>

</Project>
